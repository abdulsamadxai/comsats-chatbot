# Required: Groq API key for the chat model.
# Get one free at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional: override the Groq chat model (default: openai/gpt-oss-120b,
# Groq's replacement for the retired llama-3.3-70b-versatile).
# GROQ_MODEL=openai/gpt-oss-120b

# Optional but recommended: HuggingFace token for model downloads
# (embedding + reranker models are downloaded from HF Hub on first run).
HF_TOKEN=your_huggingface_token_here
